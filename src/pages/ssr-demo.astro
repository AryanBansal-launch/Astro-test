---
// This is server-side code that runs on each request
const timestamp = new Date().toISOString();
const userAgent = Astro.request.headers.get('user-agent') || 'Unknown';
const randomNumber = Math.floor(Math.random() * 1000);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>SSR Demo - Astro</title>
  </head>
  <body>
    <h1>Server-Side Rendered Page</h1>
    
    <div style="background: #f0f0f0; padding: 20px; margin: 20px 0; border-radius: 8px;">
      <h2>Server-Generated Data:</h2>
      <p><strong>Current Time:</strong> {timestamp}</p>
      <p><strong>Random Number:</strong> {randomNumber}</p>
      <p><strong>User Agent:</strong> {userAgent}</p>
      <p><strong>Request URL:</strong> {Astro.url.href}</p>
    </div>

    <div style="background: #e8f4fd; padding: 20px; margin: 20px 0; border-radius: 8px;">
      <h3>What's happening?</h3>
      <p>This page is rendered on the server for each request. Notice how the timestamp and random number change on each refresh!</p>
      <p>In a static site, this data would be the same for all users.</p>
    </div>

    <nav>
      <a href="/">← Back to Home</a>
    </nav>
  </body>
</html>
